      "type": "paragraph",
      "content": [
        {
          "text": "The collections framework is a set of interfaces and implementations for storing groups of objects. Nearly everything sits under two roots: "
        },
        { "text": "Collection", "marks": ["code"] },
        { "text": " and " },
        { "text": "Map", "marks": ["code"] },
        { "text": "." }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "content": [{ "text": "List" }]
    },
    {
      "type": "paragraph",
      "content": [
        { "text": "An ordered collection that allows duplicates. " },
        { "text": "ArrayList", "marks": ["code"] },
        { "text": " is backed by an array — random access is " },
        { "text": "O(1)", "marks": ["code"] },
        { "text": ", inserting in the middle is " },
        { "text": "O(n)", "marks": ["code"] },
        { "text": "." }
      ]
    },
    {
      "type": "code",
      "language": "java",
      "code": "List<String> topics = new ArrayList<>();\ntopics.add(\"arrays\");\ntopics.add(\"graphs\");\n\nfor (String topic : topics) {\n    System.out.println(topic);\n}"
    },
    {
      "type": "heading",
      "level": 2,
      "content": [{ "text": "Picking an implementation" }]
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        {
          "content": [
            { "text": "ArrayList", "marks": ["code"] },
            { "text": " — the default. Fast reads, cheap appends." }
          ]
        },
        {
          "content": [
            { "text": "LinkedList", "marks": ["code"] },
            { "text": " — only when you are constantly inserting at the ends." }
          ]
        },
        {
          "content": [
            { "text": "HashMap", "marks": ["code"] },
            { "text": " — key lookups in constant time, " },
            { "text": "no ordering guarantee", "marks": ["bold"] },
            { "text": "." }
          ]
        }
      ]
    }
  ]
